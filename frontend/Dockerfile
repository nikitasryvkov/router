FROM node:24-alpine AS build

WORKDIR /app

ARG VITE_PUBLIC_EMAIL=denis@c777.ru
ARG VITE_PUBLIC_TELEGRAM_HANDLE=@czzttt
ARG VITE_PUBLIC_TELEGRAM_URL=https://t.me/czzttt
ARG VITE_PUBLIC_OWNER_NAME="ИП Шалякин Денис Андреевич"
ARG VITE_PUBLIC_INN=233010036207
ARG VITE_PUBLIC_OGRNIP=322237500360850

ENV VITE_PUBLIC_EMAIL=$VITE_PUBLIC_EMAIL
ENV VITE_PUBLIC_TELEGRAM_HANDLE=$VITE_PUBLIC_TELEGRAM_HANDLE
ENV VITE_PUBLIC_TELEGRAM_URL=$VITE_PUBLIC_TELEGRAM_URL
ENV VITE_PUBLIC_OWNER_NAME=$VITE_PUBLIC_OWNER_NAME
ENV VITE_PUBLIC_INN=$VITE_PUBLIC_INN
ENV VITE_PUBLIC_OGRNIP=$VITE_PUBLIC_OGRNIP

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

